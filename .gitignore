# 构建产物与运行时数据（exe、Qt DLL/插件、config.json、sessions/、memory/）
build/
# go-agent 代码图本地索引缓存（/codegraph 命令或任务后自动重建生成）
# 与官方 codegraph 的 .codegraph 目录区分，避免 schema 冲突
.go-agent/
# vendored 克隆（原版 codegraph 源码，仅参考比对用，不入 git）
third_party/codegraph-upstream/
# llama.cpp 为 git submodule（third_party/llama.cpp，克隆需 --recursive 或
# git submodule update --init）；其构建产物由子模块自身 .gitignore 处理
# llama_bridge.dll 为构建产物，不入库（build-gui.ps1 每次自动构建并复制到 build/）
third_party/llama-bridge/llama_bridge.dll
# Trae移植过来的skill
TRAE-Skills-Copy/
#IDE codegraph MCP工具数据库
.codegraph/